{
    "name": "Agent-Based Processing Pipeline",
    "description": "Pipeline that uses agent-based processing steps",
    "version": "1.0.0",
    "parameters": [
        {
            "name": "input_data",
            "schema": {"type": "object"},
            "required": false,
            "description": "Input data for the agent pipeline"
        }
    ],
    "steps": [
        {
            "id": "step1",
            "name": "Data Ingestor",
            "step_class": "SimpleAgentStep",
            "module": "tests.pipelines.agent_pipeline.steps.simple_agent_step",
            "config": {
                "processing_type": "ingestion"
            },
            "inputs": [
                {"name": "task", "source": "{parameters.input_data.task}", "required": false},
                {"name": "text", "source": "{parameters.input_data.text}", "required": false}
            ],
            "outputs": [
                {"name": "agent_name", "required": true},
                {"name": "processing_type", "required": true},
                {"name": "processed_at", "required": true},
                {"name": "original_task", "required": true},
                {"name": "original_content", "required": true},
                {"name": "llm_response", "required": false},
                {"name": "metadata", "required": true}
            ]
        },
        {
            "id": "step2",
            "name": "Decision Agent",
                "step_class": "DecisionAgentStep",
                "module": "tests.pipelines.agent_pipeline.steps.decision_agent_step",
            "config": {
                "decision_logic": "validation"
            },
            "inputs": [
                {"name": "task", "source": "{steps.step1.output.original_task}", "required": false},
                {"name": "text", "source": "{steps.step1.output.original_content}", "required": false},
                {"name": "llm_response", "source": "{steps.step1.output.llm_response}", "required": false}
            ],
            "outputs": [
                {"name": "agent_name", "required": true},
                {"name": "decision_logic", "required": true},
                {"name": "processed_at", "required": true},
                {"name": "original_task", "required": true},
                {"name": "original_content", "required": true},
                {"name": "final_decision", "required": true},
                {"name": "confidence", "required": true},
                {"name": "metadata", "required": true}
            ]
        },
        {
            "id": "step3",
            "name": "Final Processor",
            "step_class": "SimpleAgentStep",
            "module": "tests.pipelines.agent_pipeline.steps.simple_agent_step",
            "config": {
                "processing_type": "final_processing"
            },
            "inputs": [
                {"name": "task", "source": "{steps.step2.output.original_task}", "required": false},
                {"name": "text", "source": "{steps.step2.output.original_content}", "required": false}
            ],
            "outputs": [
                {"name": "agent_name", "required": true},
                {"name": "processing_type", "required": true},
                {"name": "processed_at", "required": true},
                {"name": "original_task", "required": true},
                {"name": "original_content", "required": true},
                {"name": "llm_response", "required": false},
                {"name": "metadata", "required": true}
            ]
        }
    ],
    "flow": {
        "start_at": "step1",
        "paths": [
            {
                "from_step": "step1",
                "to_step": "step2",
                "condition": {"type": "always"}
            },
            {
                "from_step": "step2",
                "to_step": "step3",
                "condition": {"type": "always"}
            }
        ]
    }
}

# IA Modules Showcase App - Backend Environment Variables

# Database (optional, uses in-memory by default)
DATABASE_URL=sqlite:///./metrics.db

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3001

# Logging
LOG_LEVEL=info
DEBUG=true

# ==================== LLM CONFIGURATION ====================
# CLI type: "opencode" (OpenAI-compatible) or "claude_code" (Anthropic Claude)
DEFAULT_LLM_PROVIDER=opencode

# Provider name passed to CLI (e.g. zai-coding-plan, openai, anthropic)
LLM_PROVIDER=zai-coding-plan

# Model name
LLM_MODEL=glm-5.1

# API key for the provider
LLM_API_KEY=your_api_key_here

# Pattern execution settings
PATTERN_MAX_TOKENS=2000
PATTERN_TEMPERATURE=0.7

# ==================== AGENT CONFIGURATION ====================
# Shared workspace where agents collaborate (relative to showcase_app/)
AGENT_CWD=workspace

# Directory for agent NDJSON execution logs
# AGENT_LOGS_DIR=./logs/agents

# Agent timeout in seconds
AGENT_TIMEOUT=120
